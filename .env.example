# Copy to .env before running `docker compose up --build` from the repository root.
# The backend runs without these keys, but scoring does not complete.
# Text answers fail after their retries and surface as `failed`.
# Audio answers fail transcription and surface as `needs_a_person`.

DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1
