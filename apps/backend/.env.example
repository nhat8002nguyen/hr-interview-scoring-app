# Copy to .env before running `docker compose up --build` from this directory.
# Docker Compose reads this file for ${VAR} interpolation.

# Local ports
API_PORT=3000
POSTGRES_PORT=5432

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=talot

# API
JWT_SECRET=dev-secret-change-me-in-production
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
CANDIDATE_WEB_ORIGIN=http://localhost:3001

# Scoring
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
SCORING_WORKERS=2
SCORING_MAX_ATTEMPTS=3
SCORING_LEASE_TIMEOUT_SECONDS=300
MAX_ANSWER_SUBMISSIONS=3

# Seeded HR account
SEED_HR_EMAIL=hr@talotrace.ai
SEED_HR_PASSWORD=change-me
